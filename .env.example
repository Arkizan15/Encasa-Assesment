[TEMPLATE]
# ⚠️ Salin ke .env (atau set di Vercel > Settings > Environment Variables)

# ── KEAMANAN (WAJIB) ──
# Secret untuk menandatangani token sesi tes (HMAC). Ganti dengan string acak
# panjang. Tanpa ini dipakai fallback 'encasa-dev-secret-change-me'.
ENCASA_SCORE_SECRET=

# ── JALUR PALING MUDAH: Google Apps Script (tanpa Cloud Console) ──
# 1. Buka spreadsheet → Extensions (Ekstensi) → Apps Script
# 2. Tempel isi apps-script/Code.gs → Deploy → New deployment → Web app
#    (Execute as: Me · Who has access: Anyone)
# 3. Salin URL hasil deploy → tempel ke sini:
GOOGLE_APPS_SCRIPT_URL=

# OPSIONAL: rahasia bersama untuk memblokir panggilan langsung ke URL Apps Script
# (set nilai yang SAMA di Script Properties "APP_SECRET" pada Apps Script).
APPS_SCRIPT_SECRET=

# ── JALUR ALTERNATIF: Service Account (butuh Google Cloud Console) ──
GOOGLE_SHEET_ID=1x4Fzgyv2D4BvX_NAYpn_39Kjd7Q4uxz0mBw3-SmyJkw
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
