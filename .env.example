# ⚠️ Salin ke .env (atau set di Vercel > Settings > Environment Variables)

# ── JALUR PALING MUDAH: Google Apps Script (tanpa Cloud Console) ──
# 1. Buka spreadsheet → Extensions (Ekstensi) → Apps Script
# 2. Tempel isi apps-script/Code.gs → Deploy → New deployment → Web app
#    (Execute as: Me · Who has access: Anyone)
# 3. Salin URL hasil deploy ke salah satu tempat di bawah:

# Dipakai serverless /api/submit-score (Vercel atau npm run serve):
GOOGLE_APPS_SCRIPT_URL=

# ATAU dipakai frontend langsung (harus di-set SEBELUM build — Vite):
VITE_APPS_SCRIPT_URL=

# ── JALUR ALTERNATIF: Service Account (butuh Google Cloud Console) ──
GOOGLE_SHEET_ID=1x4Fzgyv2D4BvX_NAYpn_39Kjd7Q4uxz0mBw3-SmyJkw
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
